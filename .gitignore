# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# apps/* kendi bağımlılıklarını ve build çıktısını taşır (ayrı package.json'lar)
apps/*/node_modules
apps/*/dist

# python (scripts/ar-pipeline/)
__pycache__/
*.pyc

# typescript
*.tsbuildinfo
next-env.d.ts

# Bu proje klasörüyle ilgisiz, kendi ayrı git repoları olan araç/referans klasörleri —
# yanlışlıkla bu repoya dahil olmasınlar diye.
/awesome-claude-skills/
/superpowers/

# Büyük ekran kaydı — repo boyutunu şişirmesin diye
*.mp4
# Planlayıcı hero'sunda gerçekten kullanılan, canlıya deploy edilmesi gereken video (~1MB)
!public/videos/planlayici-hero.mp4
