# Supabase Postgres — Project Settings > Database > Connection string
# Pooled (transaction mode, port 6543) — uygulamanın normal çalışma zamanı bağlantısı.
# connection_limit=1 şart: PgBouncer transaction modunda her Prisma Client instance'ının
# (build worker'ları, serverless function'lar) kendi büyük bir bağlantı havuzu açmasını
# engeller — yoksa Supabase'in havuz limiti (genelde 21) `next build` sırasında bile
# tükenip "Timed out fetching a new connection from the connection pool" hatası verir.
DATABASE_URL="postgresql://postgres.[proje-ref]:[şifre]@aws-0-[bölge].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30"
# Direct (port 5432) — sadece `prisma db push` / migration çalıştırırken kullanılır
DIRECT_URL="postgresql://postgres.[proje-ref]:[şifre]@aws-0-[bölge].pooler.supabase.com:5432/postgres"

# Auth.js (NextAuth v5) — `openssl rand -base64 32` ile üretilebilir
AUTH_SECRET=""

# Google ile giriş — console.cloud.google.com > APIs & Services > Credentials >
# Create Credentials > OAuth client ID (Web application). Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (+ canlıda gerçek domain'in aynısı)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple ile giriş — Apple Developer Program (ücretli) hesabı + Services ID + Sign in
# with Apple key gerektirir. Redirect URI: https://[domain]/api/auth/callback/apple
# (Apple http://localhost'u kabul etmez, test için de gerçek bir domain/tünel gerekir)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# İkisi de boş bırakılırsa /giris sayfası bu butonları hiç göstermez (bkz. src/lib/auth.ts).

# Yönetim paneli (/admin) girişi — `npm run db:seed` çalıştırıldığında bu e-posta/şifreyle
# ADMIN rolünde bir kullanıcı oluşturulur (zaten kayıtlı bir hesapsa role=ADMIN yapılır).
# Boş bırakılırsa admin kullanıcı adımı atlanır. Aynı adres, iletişim formu bildirim
# e-postalarının gönderileceği adres olarak da kullanılır (bkz. contact-actions.ts).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# İletişim formu bildirimi — resend.com üzerinden API anahtarı alınabilir. Boş bırakılırsa
# e-posta gönderilmez ama mesajlar yine de veritabanına kaydedilir ve /admin/mesajlar'dan
# görülebilir (bkz. contact-actions.ts). RESEND_FROM_EMAIL boş bırakılırsa Resend'in
# doğrulanmamış alan adı için verdiği sandbox adresi (onboarding@resend.dev) kullanılır —
# gerçek gönderim hacmi için kendi alan adınızı Resend'de doğrulayıp burayı güncelleyin.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Canlı domain — sitemap.xml, robots.txt ve sayfa metadata'sındaki canonical/Open Graph
# URL'leri için kullanılır (bkz. src/lib/seo.ts). Boş bırakılırsa https://ozcanmobilya.com
# varsayılır.
NEXT_PUBLIC_SITE_URL="https://ozcanmobilya.com"

# Google Analytics 4 — analytics.google.com'da mülk oluşturunca alınan Ölçüm Kimliği
# ("G-" ile başlar). Boş bırakılırsa GA4 scripti hiç yüklenmez (bkz.
# src/components/analytics/GoogleAnalytics.tsx) — view_item/add_to_cart/begin_checkout/
# purchase olayları zaten koda gömülü, sadece bu kimlik girilince veri akmaya başlar.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# PayTR (kredi kartı ile ödeme, iFrame API) — PayTR Mağaza Paneli'nde Ayarlar > Mağaza
# Bilgileri sayfasından alınır. Üçü de doldurulmadan checkout'ta "Kredi Kartı" seçeneği hiç
# görünmez, sadece Kapıda Ödeme/Havale-EFT seçenekleri gösterilir (bkz. lib/payment/paytr.ts
# isPaytrConfigured). Ayrıca PayTR Mağaza Paneli'nde "Bildirim URL'si" alanına
# https://[domain]/api/odeme/paytr-bildirim adresinin girilmesi gerekir — aksi halde ödeme
# tamamlansa bile paymentStatus otomatik PAID'e çekilmez.
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""

# WhatsApp Cloud API (Meta for Developers > WhatsApp > API Setup) — sitedeki "Kararsız
# mısınız?" popup widget'ının (bkz. WhatsAppButton.tsx, lib/actions/whatsapp-actions.ts)
# "Gönder" butonu, ziyaretçiyi WhatsApp uygulamasına yönlendirmek yerine mesajı bu API
# üzerinden doğrudan işletmenin WhatsApp numarasına (905054423809) iletir. WHATSAPP_ACCESS_TOKEN
# kalıcı bir token olmalı (System User token — geçici "temporary access token" 24 saatte
# geçersiz olur). WHATSAPP_PHONE_NUMBER_ID, API Setup sayfasındaki gönderen numaranın ID'sidir
# (işletmenin kendi numarasından farklı olabilir — WhatsApp bunu gönderen olarak kullanır).
# Boş bırakılırsa "Gönder" butonu hata mesajı gösterir (bkz. sendWhatsAppMessageAction).
# Not: WhatsApp Business API, 24 saatlik "müşteri hizmetleri penceresi" dışında serbest metin
# gönderimini kısıtlar — bu numara son 24 saat içinde size mesaj atmamış bir müşteriyle
# konuşmaya bu şekilde başlamış olursanız Meta gönderimi reddedebilir.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Oda & Mobilya Planlayıcı (apps/planner) entegrasyonu — planlayıcı ayrı bir
# orijinde (tasarla.ozcanmobilya.com) deploy edildiğinden çerez paylaşamıyor;
# bunun yerine ürün sayfasından çıkışta imzalanıp planlayıcıya taşınan,
# 60 saniyelik kısa ömürlü bir devir token'ıyla kimlik aktarılır (bkz.
# src/lib/planner-handoff.ts, Mimari Doküman §1.2). PLANNER_HANDOFF_SECRET
# `openssl rand -base64 32` ile üretilebilir; yalnızca bu uygulamada bilinir,
# planlayıcıya asla gönderilmez (planlayıcı sadece opak token string'ini taşır).
# İkisi de doldurulmadan ürün sayfasında "Odanda Tasarla" CTA'sı hiç
# görünmez (bkz. isPlannerConfigured) — planlayıcı henüz ayrı deploy
# edilmediği sürece çalışmayan bir buton göstermemek için.
PLANNER_HANDOFF_SECRET=""
NEXT_PUBLIC_PLANNER_URL=""
