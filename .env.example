# Supabase Postgres — Project Settings > Database > Connection string
# Pooled (transaction mode, port 6543) — uygulamanın normal çalışma zamanı bağlantısı
DATABASE_URL="postgresql://postgres.[proje-ref]:[şifre]@aws-0-[bölge].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — sadece `prisma db push` / migration çalıştırırken kullanılır
DIRECT_URL="postgresql://postgres.[proje-ref]:[şifre]@aws-0-[bölge].pooler.supabase.com:5432/postgres"

# Auth.js (NextAuth v5) — `openssl rand -base64 32` ile üretilebilir
AUTH_SECRET=""
